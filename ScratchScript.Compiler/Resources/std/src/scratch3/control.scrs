@skipFeature("unusedFunctions", "packFrameAllocationFunctions")
namespace "std/scratch3/control";

/* enum StopTarget {
    All = "all",
    ThisScript = "this script",
    OtherScripts = "other scripts"
} */

@inline function wait(seconds: number) {
    __raw("control_wait", {inputs: {DURATION: seconds}});
}

@inline function waitUntil(condition: boolean) {
    __raw("control_wait_until", {inputs: {CONDITION: condition}});
}

@inline function stop(target: string) {
    __raw("control_stop", {fields: {STOP_OPTION: target}});
}